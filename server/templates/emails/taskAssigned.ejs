<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
</head>

<body style="margin:0; padding:0; background-color:#f3f4f6; font-family:Arial, sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" style="padding:30px 0;">
    <tr>
      <td align="center">

        <!-- MAIN CONTAINER -->
        <table width="600" cellpadding="0" cellspacing="0"
          style="background:#ffffff; border-radius:12px; padding:28px; box-shadow:0 2px 6px rgba(0,0,0,0.05);">

          <!-- HEADER -->
          <tr>
            <td style="padding-bottom:20px; border-bottom:1px solid #e5e7eb;">
              <h2 style="margin:0; color:#4f46e5; font-size:22px;">
                🚀 TaskFlow
              </h2>
              <p style="margin:6px 0 0; color:#6b7280; font-size:13px;">
                Smart Task Management Platform
              </p>
            </td>
          </tr>

          <!-- TITLE -->
          <tr>
            <td style="padding:20px 0 10px;">
              <h3 style="margin:0; font-size:18px; color:#111827;">
                Task Assignment Notification
              </h3>
            </td>
          </tr>

          <!-- GREETING -->
          <tr>
            <td style="padding-bottom:10px;">
              <p style="margin:0; font-size:14px; color:#111827;">
                Dear <strong><%= name %></strong>,
              </p>
            </td>
          </tr>

          <!-- INTRO MESSAGE -->
          <tr>
            <td>
              <p style="margin:10px 0; font-size:14px; color:#374151; line-height:1.6;">
                This is to inform you that a new task has been assigned to you 
                <% if (adminName) { %>
                  by <strong><%= adminName %></strong>
                <% } %> through the TaskFlow system.
              </p>

              <p style="margin:10px 0; font-size:14px; color:#374151; line-height:1.6;">
                You are requested to review the task details carefully and ensure timely execution 
                in accordance with the assigned priority and deadline.
              </p>
            </td>
          </tr>

          <!-- TASK DETAILS CARD -->
          <tr>
            <td style="padding-top:12px;">
              <table width="100%" cellpadding="0" cellspacing="0"
                style="background:#f9fafb; border-radius:10px; padding:16px; border:1px solid #f1f5f9;">
                
                <tr>
                  <td style="padding:6px 0;">
                    <strong style="color:#111827;">📌 Task Title</strong><br/>
                    <span style="color:#374151;"><%= title %></span>
                  </td>
                </tr>

                <tr>
                  <td style="padding:6px 0;">
                    <strong style="color:#111827;">📝 Description</strong><br/>
                    <span style="color:#374151;"><%= description || "No additional description provided." %></span>
                  </td>
                </tr>

                <tr>
                  <td style="padding:6px 0;">
                    <strong style="color:#111827;">⚡ Priority</strong><br/>
                    <span style="color:#4f46e5;"><%= priority || "Normal" %></span>
                  </td>
                </tr>

                <tr>
                  <td style="padding:6px 0;">
                    <strong style="color:#111827;">📅 Deadline</strong><br/>
                    <span style="color:#374151;"><%= dueDate %></span>
                  </td>
                </tr>

                <% if (taskId) { %>
                <tr>
                  <td style="padding:6px 0;">
                    <strong style="color:#111827;">🆔 Task ID</strong><br/>
                    <span style="color:#6b7280;"><%= taskId %></span>
                  </td>
                </tr>
                <% } %>

              </table>
            </td>
          </tr>

          <!-- CTA -->
          <tr>
            <td align="left" style="padding-top:24px;">
              <a href="<%= taskLink %>"
                 style="display:inline-block; padding:12px 20px; background:#4f46e5; 
                 color:#ffffff; text-decoration:none; border-radius:8px; font-size:14px; font-weight:500;">
                 Access Task Dashboard
              </a>
            </td>
          </tr>

          <!-- GUIDELINE -->
          <tr>
            <td style="padding-top:18px;">
              <p style="margin:0; font-size:13px; color:#6b7280; line-height:1.6;">
                Please ensure that all assigned responsibilities are completed within the stipulated timeline. 
                In case of any blockers, dependencies, or clarifications required, you are advised to 
                coordinate with your reporting manager at the earliest.
              </p>
            </td>
          </tr>

          <!-- SUPPORT -->
          <tr>
            <td style="padding-top:12px;">
              <p style="margin:0; font-size:13px; color:#6b7280;">
                For technical assistance, please contact the system administrator or support team.
              </p>
            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td style="padding-top:25px; border-top:1px solid #e5e7eb;">
              <p style="margin:0; font-size:12px; color:#9ca3af;">
                This is an automated system-generated email from TaskFlow. Kindly do not reply to this message.
              </p>

              <p style="margin:6px 0 0; font-size:12px; color:#9ca3af;">
                © <%= new Date().getFullYear() %> TaskFlow Inc. All rights reserved.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>