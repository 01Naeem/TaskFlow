<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
</head>

<body style="margin:0; padding:0; background-color:#f3f4f6; font-family: Arial, sans-serif;">

  <!-- PREHEADER -->
  <div style="display:none; max-height:0; overflow:hidden;">
    Your TaskFlow account has been created. Please review your credentials and access instructions.
  </div>

  <table width="100%" cellpadding="0" cellspacing="0" style="padding: 30px 0;">
    <tr>
      <td align="center">

        <!-- MAIN CONTAINER -->
        <table width="600" cellpadding="0" cellspacing="0"
          style="background:#ffffff; border-radius:12px; overflow:hidden; box-shadow:0 6px 24px rgba(0,0,0,0.08);">

          <!-- HEADER -->
          <tr>
            <td style="background:#4f46e5; padding:26px; text-align:center;">
              <h1 style="margin:0; color:#ffffff; font-size:22px;">TaskFlow</h1>
              <p style="margin:6px 0 0; color:#c7d2fe; font-size:13px;">
                Enterprise Task Management Platform
              </p>
            </td>
          </tr>

          <!-- BODY -->
          <tr>
            <td style="padding:32px;">

              <!-- INTRO -->
              <h2 style="margin:0 0 12px; color:#111827; font-size:20px;">
                Welcome to TaskFlow, <%= name %>
              </h2>

              <p style="margin:0 0 16px; color:#4b5563; font-size:14px; line-height:1.6;">
                We are pleased to inform you that your account has been successfully provisioned 
                on <strong>TaskFlow</strong> by <strong><%= adminName %></strong>.
              </p>

              <p style="margin:0 0 16px; color:#4b5563; font-size:14px; line-height:1.6;">
                TaskFlow is designed to streamline task management, improve collaboration, and enhance productivity 
                across teams. You can now securely access your workspace using the credentials provided below.
              </p>

              <!-- ACCOUNT DETAILS -->
              <h3 style="font-size:14px; color:#111827; margin-bottom:10px;">
                Account Credentials
              </h3>

              <table width="100%" cellpadding="0" cellspacing="0"
                style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px; padding:16px;">
                <tr>
                  <td style="font-size:14px; color:#111827;">
                    <p style="margin:6px 0;"><strong>Email Address:</strong> <%= email %></p>
                    <p style="margin:6px 0;"><strong>Temporary Password:</strong> <%= password %></p>
                    <p style="margin:6px 0;"><strong>Department:</strong> <%= department %></p>
                    <p style="margin:6px 0;"><strong>Designation:</strong> <%= designation %></p>
                  </td>
                </tr>
              </table>

              <!-- CTA -->
              <div style="text-align:center; margin:32px 0;">
                <a href="<%= loginUrl %>"
                  style="display:inline-block; background:#4f46e5; color:#ffffff;
                  padding:12px 24px; text-decoration:none; border-radius:6px;">
                  Sign In to Your Account
                </a>
              </div>

              <!-- ACCESS NOTE -->
              <p style="font-size:13px; color:#6b7280; text-align:center;">
                If the button above does not function as expected, please copy and paste the following URL into your browser:
              </p>

              <p style="font-size:13px; color:#4f46e5; text-align:center;">
                <%= loginUrl %>
              </p>

              <!-- SECURITY SECTION -->
              <hr style="border:none; border-top:1px solid #e5e7eb; margin:28px 0;" />

              <h3 style="font-size:14px; color:#111827; margin-bottom:8px;">
                Security Guidelines
              </h3>

              <ul style="font-size:13px; color:#6b7280; padding-left:18px; line-height:1.6;">
                <li>For security purposes, please update your password immediately after your first login.</li>
                <li>Do not share your credentials with anyone, including colleagues.</li>
                <li>TaskFlow will never request your password via email or phone.</li>
              </ul>

              <!-- SUPPORT -->
              <hr style="border:none; border-top:1px solid #e5e7eb; margin:28px 0;" />

              <p style="font-size:14px; color:#4b5563;">
                If you require any assistance during onboarding or while using the platform, our support team is available to help.
              </p>

              <p style="font-size:14px;">
                📧 <a href="mailto:support@taskflow.com" style="color:#4f46e5; text-decoration:none;">
                  support@taskflow.com
                </a>
              </p>

              <!-- SIGN-OFF -->
              <p style="margin-top:20px; font-size:14px; color:#4b5563;">
                We look forward to supporting your work and helping you achieve greater efficiency with TaskFlow.
              </p>

              <p style="margin-top:16px; font-size:14px; color:#111827;">
                Best regards,<br/>
                <strong>TaskFlow Team</strong>
              </p>

            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td style="background:#f9fafb; padding:20px; text-align:center;">
              <p style="font-size:12px; color:#9ca3af; margin:0;">
                © <%= new Date().getFullYear() %> TaskFlow Inc. All rights reserved.
              </p>
              <p style="font-size:12px; color:#9ca3af; margin-top:6px;">
                This is an automated communication. Please do not reply directly to this email.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>